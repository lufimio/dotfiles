input {
    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }
    touchpad {
        tap
        accel-speed 0.0
        natural-scroll
        dwt
        middle-emulation
        scroll-method "two-finger"
        drag-lock
    }
    keyboard {
        numlock
    }
}

