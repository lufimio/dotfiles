+static double overviewDragEdgeVelocity(double point, double extent, double zone, double speed) {
+    if (!std::isfinite(point) || extent <= 0 || zone <= 0 || speed <= 0)
+        return 0;
+    zone = std::min(zone, extent * 0.5);
+    if (point < zone)
+        return -speed * std::pow(std::clamp((zone - point) / zone, 0.0, 1.0), 2);
+    if (point > extent - zone)
+        return speed * std::pow(std::clamp((point - extent + zone) / zone, 0.0, 1.0), 2);
+    return 0;
+}
